<?xml version="1.0" encoding="utf-8"?>
<!--
  Copia de seguridad de Android hasta Android 11 (android:fullBackupContent). Mismas reglas que
  data_extraction_rules.xml (Android 12 y posteriores): cambia los dos archivos a la vez.

  Lista cerrada (§8.5): solo la base de datos (con su registro -wal, que puede tener los últimos cambios; el -shm se
  rehace solo) y los ajustes (files/datastore/ajustes.preferences_pb). Todo lo demás se queda fuera sin nombrarlo:
  las fotos (no caben en los 25 MB de la copia de Android), las copias del teléfono, los borradores, el estado del
  teléfono (files/datastore/estado-local.preferences_pb: archivo de Drive, fechas y errores de las copias…), la base
  de datos de WorkManager y la caché. Lo que una tarea guarde en el futuro tampoco entra si no se añade aquí.
  Etapa 3: la clave de la IA no se añade nunca.
-->
<full-backup-content>
    <include domain="database" path="recetario.db" />
    <include domain="database" path="recetario.db-wal" />
    <include domain="file" path="datastore/ajustes.preferences_pb" />
</full-backup-content>
